MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1981443273}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d36a2d3efc7555d47aa1d5666eb3f05a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialController
  controller: {fileID: 470283026}
  view: {fileID: 1981443275}
  terminal: {fileID: 2130747672}
  rows:
  - {fileID: 1057748722}
  - {fileID: 1543500286}
  - {fileID: 1654147644}
  - {fileID: 620149446}
  tips:
  - round: 0
    beforeClock: 0
    title: PRESS LOCK
    body: 'WAIT UNTIL A TARGET IS IN

      THE BRIGHT PART OF THE BEAM,

      THEN
      PRESS LOCK.'
    goal: 1
    highlight: 1
    targets:
    - {fileID: 1327358963}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: THREAT TABLE
    body: 'EVERY SIGNAL HAS A ROW.

      LAMPS SHOW ITS POWER: 1 TO 3.

      LOCK
      EVERY TARGET.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 356317055}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: DECODE THE TYPE
    body: 'PRESS DECODE TO REVEAL

      THE ATTACK TYPE: AIR OR GROUND.

      ONLY
      LOCKED TARGETS CAN BE DECODED.'
    goal: 2
    highlight: 2
    targets: []
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: LIMITED DECODES
    body: 'EACH DECODE USES ONE LAMP.

      UNUSED LAMPS DO NOT CARRY OVER.

      CHOOSE
      WISELY.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 1842179575}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: ASSIGN DEFENSE
    body: 'AA STOPS AIR. GROUND STOPS GROUND.

      UNIVERSAL HALVES ANY HIT,

      ONLY
      ONE PER WAVE.

      PICK A DEFENSE FOR THIS SECTOR.'
    goal: 3
    highlight: 3
    targets: []
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: LIMITED ORDERS
    body: 'EACH ORDER USES ONE LAMP.

      ONE ORDER DEFENDS ONE SECTOR.

      WRONG
      DEFENSE STOPS NOTHING.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 565985790}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: TERMINAL
    body: 'EVERY REPORT IS PRINTED HERE:

      DECODED SIGNALS, LOST TARGETS

      AND
      DAMAGE AFTER EACH WAVE.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 1888832983}
    top: 1
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: BASE HP
    body: 'REAL ATTACKS WITHOUT DEFENSE

      DAMAGE THE BASE.

      AT ZERO, THE
      BASE FALLS.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 1060697664}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 0
    beforeClock: 0
    title: PRESS CONFIRM
    body: 'PLACE ALL ORDERS,

      THEN PRESS CONFIRM.'
    goal: 4
    highlight: 1
    targets:
    - {fileID: 829977647}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 1
    beforeClock: 1
    title: FALSE ALARMS
    body: 'SOME SIGNALS ARE FALSE: NO DAMAGE.

      DECODE VALID TO CHECK A THREAT.

      AN
      ORDER ON A FALSE ALARM IS WASTED.

      TYPES ARE DECODED THIS WAVE.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 1155291307}
    - {fileID: 1758231063}
    - {fileID: 613832621}
    - {fileID: 367557199}
    - {fileID: 148434800}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 1
    beforeClock: 1
    title: MOVING TARGETS
    body: 'TARGETS NOW MOVE TO THE BASE.

      LOCK THEM BEFORE THE INNER CIRCLE

      OR
      THEIR DATA IS LOST.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 107077892}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 1
    beforeClock: 1
    title: TIME
    body: 'CONFIRM BEFORE TIME RUNS OUT.

      OTHERWISE EVERY REAL

      ATTACK
      HITS.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 1783942458}
    top: 0
    revealsTimer: 1
    alarm: 0
  - round: 2
    beforeClock: 1
    title: CREWS LOST
    body: 'TWO DEFENSE CREWS WERE LOST.

      FROM NOW ON, ONLY 2 ORDERS A WAVE.

      YOU
      CANNOT COVER EVERY SECTOR.

      CHOOSE WHAT TO LET GO.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 565985790}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 5
    beforeClock: 1
    title: 'COMMAND: EMP STRIKE'
    body: 'ENEMY EMP DETONATED OVER

      YOUR SECTOR. THIS CONSOLE IS

      TOO
      OLD TO HAVE EMP SHIELDING.

      EXPECT SYSTEM FAILURES.'
    goal: 0
    highlight: 0
    targets: []
    top: 0
    revealsTimer: 0
    alarm: 1
  - round: 5
    beforeClock: 1
    title: EMP DAMAGE
    body: 'THE RADAR SHOWS FALSE ECHOES.

      LOCKING ONE DISABLES LOCK.

      CLOCK
      DAMAGED. TIME IS SHORT.

      NO VALIDATION: ALL SIGNALS REAL.'
    goal: 0
    highlight: 0
    targets: []
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 5
    beforeClock: 1
    title: POWER SURGE
    body: 'OLD TECH, STRANGE LUCK:

      THE SURGE REVIVED TWO DEFENSE

      CREWS.
      4 ORDERS THIS WAVE.

      BUT ONE DECODER BURNED OUT.'
    goal: 0
    highlight: 1
    targets:
    - {fileID: 1842179575}
    - {fileID: 565985790}
    top: 0
    revealsTimer: 0
    alarm: 0
  - round: 6
    beforeClock: 1
    title: CLOCK RESTORED
    body: 'THE CLOCK IS WORKING AGAIN.

      THE RADAR IS STILL DAMAGED:

      FALSE
      ECHOES MAY APPEAR.

      SURGE OVER: 2 ORDERS, 4 DECODES.'
    goal: 0
    highlight: 0
    targets: []
    top: 0
    revealsTimer: 0
    alarm: 0
  tipDelay: 2
  alarm: {fileID: 1581967352}
